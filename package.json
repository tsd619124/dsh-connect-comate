{
  "name": "dsh-connect-comate",
  "displayName": "DSH Connect Comate",
  "description": "把本机已登录的文心快码（Comate / Zulu）接成 DSH 的模型 provider，含设置页模型勾选、提问转述与只读用量查询",
  "version": "0.3.1",
  "author": "fengguanjia",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "comate",
    "zulu",
    "baidu",
    "model-provider",
    "credits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsd619124/dsh-connect-comate.git"
  },
  "homepage": "https://github.com/tsd619124/dsh-connect-comate#readme",
  "bugs": {
    "url": "https://github.com/tsd619124/dsh-connect-comate/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.0 <0.3"
  },
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.0 <0.3.0-0 || >=0.2.2-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.0 <0.3.0-0 || >=0.2.2-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.0 <0.3.0-0 || >=0.2.2-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.0 <0.3.0-0 || >=0.2.2-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.3 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
